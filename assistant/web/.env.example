JARVIS_WEB_HOST=127.0.0.1
JARVIS_WEB_PORT=47833
# Server-side proxy target. No passwords or provider keys belong in browser code.
JARVIS_SERVER_URL=http://127.0.0.1:47832
# Optional exact origins of your own sites allowed to frame the pet.
# Same-site embedding works; cross-site authentication/pairing is deferred.
JARVIS_EMBED_ORIGINS=
