# Copy to .env, then replace the token with your own random value (24+ characters).
JARVIS_KNOWLEDGE_TOKEN=replace-with-your-own-random-owner-token
JARVIS_KNOWLEDGE_DATABASE_URL=postgres://jarvis:jarvis-dev-only@127.0.0.1:55432/jarvis_knowledge
JARVIS_KNOWLEDGE_URL=http://127.0.0.1:47831
JARVIS_KNOWLEDGE_BIND=127.0.0.1:47831
JARVIS_KNOWLEDGE_DATA_DIR=.data/originals

# Local development database only. Keep DATABASE_URL above in sync if changed.
# Existing Docker volumes keep their original credentials.
POSTGRES_DB=jarvis_knowledge
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis-dev-only
