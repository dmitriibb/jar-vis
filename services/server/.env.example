JARVIS_SERVER_HOST=127.0.0.1
JARVIS_SERVER_PORT=47832
# Choose a random password (24+ characters). Enter it once in the browser.
JARVIS_SERVER_TOKEN=replace-with-your-own-random-server-password
# Browser addresses allowed to send requests. Comma-separated, exact origins.
JARVIS_WEB_ORIGINS=http://localhost:47833,http://127.0.0.1:47833
# Set true behind HTTPS. Keep false for local HTTP development.
JARVIS_COOKIE_SECURE=false

# Leave blank to discover your EXISTING OpenCode service via service.json.
OPENCODE_URL=
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=
# Optional provider/model; blank uses your existing OpenCode model settings.
OPENCODE_MODEL=
# Initial agent; UI defaults in .data/settings.json take precedence after saving.
JARVIS_DEFAULT_AGENT=jarvis-home-assistant
JARVIS_WORKSPACE=.data/workspace

# Optional knowledge. Reads its .env on the server, never in the browser.
# Set this to an empty value to disable knowledge entirely.
JARVIS_KNOWLEDGE_ENV_FILE=../knowledge/.env
# Optional overrides; blank uses the knowledge .env.
JARVIS_KNOWLEDGE_URL=
JARVIS_KNOWLEDGE_TOKEN=
